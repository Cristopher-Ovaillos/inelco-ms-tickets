# etapa 1: compila TypeScript y genera swagger-output.json
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && npm run swagger

# etapa 2: solo lo necesario para correr
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/swagger-output.json ./
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
